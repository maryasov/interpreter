# interpreter — environment configuration
# Copy to `.env` and fill in. `.env` is gitignored; never commit real secrets.
# These vars are read at startup (see src/agent/config.ts) and override config.toml.

# --- LLM provider (any OpenAI-compatible chat-completions endpoint) ----------
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-your-key-here

# --- HTTP job API / MCP server (optional) ------------------------------------
# INTERPRETER_HOST=127.0.0.1
# INTERPRETER_PORT=4100
# When set, callers must send: Authorization: Bearer <INTERPRETER_TOKEN>
# INTERPRETER_TOKEN=change-me
